# Database (PostgreSQL)
POSTGRES_USER=wheretowatch
POSTGRES_PASSWORD=wheretowatch_dev
POSTGRES_DB=wheretowatch
POSTGRES_PORT=5433
DATABASE_URL="postgresql://wheretowatch:wheretowatch_dev@localhost:5433/wheretowatch?schema=public"

# Cache & Queue (Redis)
REDIS_PORT=6380
REDIS_URL="redis://localhost:6380"

# Search (Meilisearch)
MEILI_ENV=development
MEILI_PORT=7700
MEILI_URL="http://localhost:7700"
MEILI_MASTER_KEY="wheretowatch_meili_dev_key"

# External APIs (never commit real keys)
TMDB_API_KEY=""
TMDB_READ_ACCESS_TOKEN=""
WATCHMODE_API_KEY=""
OMDB_API_KEY=""

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DEFAULT_COUNTRY="IN"
LOG_LEVEL="info"
